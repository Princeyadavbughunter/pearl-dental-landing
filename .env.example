# Where this landing page is actually served from. Sets metadataBase, the
# canonical URL and the sitemap host. Leave unset in development.
NEXT_PUBLIC_SITE_URL=https://pearl-dental-chennai.vercel.app

# The page is noindex by default so it cannot compete with the clinic's own
# site. Set to "true" only if the client decides it should be indexed.
NEXT_PUBLIC_INDEXABLE=false

# Server-side lead destination — Google Apps Script, Zapier or the CRM endpoint.
# Private: never prefix this with NEXT_PUBLIC_. Leads are recorded in the server
# log whether or not it is set, so nothing is lost while the CRM sheet is built.
LEAD_WEBHOOK=
